# Server Production Environment Variables Template
PORT=5000
NODE_ENV=production

# Frontend Client URL(s) allowed for CORS (comma-separated if multiple, e.g. https://thaniyam-treats.vercel.app)
CLIENT_URL=http://localhost:5173

# Production Database Connection String
# Supports TiDB Cloud MySQL (DATABASE_URL / MYSQL_URI) or MongoDB Atlas (MONGODB_URI)
DATABASE_URL=mysql://<username>:<password>@<host>:4000/<database>
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/thaniyam_treats?retryWrites=true&w=majority

# Admin Credentials for Store Portal Access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SECRET=thaniyam-admin-production-secret-key-2026
